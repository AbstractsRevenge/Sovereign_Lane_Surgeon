soong_namespace {
    imports: [
        "hardware/google/gchips",
        "hardware/google/graphics/common",
    ],
}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "zumapro_libhwc2_1_srcs",
    srcs: [
        "libmaindisplay/ExynosPrimaryDisplayModule.cpp",
    ],
}

cc_library_shared {
    name: "libexynosdisplay",
    srcs: [
        ":zumapro_libhwc2_1_srcs",
        "//hardware/google/graphics/zuma/libhwc2.1:zuma_for_zumapro_libhwc2_1_srcs",
        "//hardware/google/graphics/gs101/libhwc2.1:gs101_for_zuma_zumapro_libhwc2_1_srcs",
        "//hardware/google/graphics/gs201/libhwc2.1:gs201_for_zuma_zumapro_libhwc2_1_srcs",
    ],
    cflags: [
        "-DDISPLAY_COLOR_LIB=\"libdisplaycolor.so\"",
    ],
    header_libs: [
        "//hardware/google/graphics/gs201:gs201_graphics_histogram_header",
    ],
    include_dirs: [
        "hardware/google/graphics/gs101/include/gs101",
        "hardware/google/graphics/zumapro/include",
    ] + [
        // From original common which will use each soc's own folder.
        "hardware/google/graphics/zumapro/libhwc2.1",
        "hardware/google/graphics/zumapro/libhwc2.1/libmaindisplay",
        "hardware/google/graphics/zumapro/libhwc2.1/libexternaldisplay",
        "hardware/google/graphics/zumapro/libhwc2.1/libvirtualdisplay",
        "hardware/google/graphics/zumapro/libhwc2.1/libresource",
        "hardware/google/graphics/zumapro/libhwc2.1/libcolormanager",
        "hardware/google/graphics/zumapro/libhwc2.1/libdevice",
        "hardware/google/graphics/zumapro/libhwc2.1/libresource",
        "hardware/google/graphics/zumapro/libhwc2.1/libdisplayinterface",
        "hardware/google/graphics/zumapro",
    ],
    defaults: [
        "libexynosdisplay_common_cc_default",
    ],
}
